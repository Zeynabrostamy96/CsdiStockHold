# Normalize line endings: LF in the repository and in the working tree on every OS.
* text=auto eol=lf

# Better diff hunk headers for C#
*.cs   text diff=csharp

# Windows-only scripts keep CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary files: never convert or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.dll  binary
*.exe  binary
